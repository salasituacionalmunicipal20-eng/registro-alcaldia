      ".read": "auth.token.email === 'carlos.admin@alcaldia.com' || root.child('operadores').child(auth.uid).child('rol').val() === 'admin'",
      "$id": {
        ".write": "(!data.exists() && newData.exists()) || auth.token.email === 'carlos.admin@alcaldia.com'",
        ".validate": "newData.hasChildren(['nombres','apellidos']) && newData.child('nombres').isString() && newData.child('nombres').val().length <= 150 && newData.child('apellidos').isString() && newData.child('apellidos').val().length <= 150"
      }
    },
    "refugiados_fotos": {
      ".read": "auth.token.email === 'carlos.admin@alcaldia.com' || root.child('operadores').child(auth.uid).child('rol').val() === 'admin'",
      "$id": {
        ".write": "(!data.exists() && newData.exists()) || auth.token.email === 'carlos.admin@alcaldia.com'",
        ".validate": "newData.isString() && newData.val().length <= 800000"
      }
    },
    "acopio": {
      ".read": "auth.token.email === 'carlos.admin@alcaldia.com' || root.child('operadores').child(auth.uid).child('rol').val() === 'admin'",
