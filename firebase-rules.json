{
  "rules": {
    "habitantes": {
      ".read": "auth.token.email === 'carlos.admin@alcaldia.com' || root.child('operadores').child(auth.uid).exists()",
      "$habitanteId": {
        ".write": "auth.token.email === 'carlos.admin@alcaldia.com' || (auth != null && root.child('operadores').child(auth.uid).exists() && newData.exists())"
      }
    },
    "operadores": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth.token.email === 'carlos.admin@alcaldia.com'",
        "cambio_obligatorio": {
          ".write": "auth.token.email === 'carlos.admin@alcaldia.com' || $uid === auth.uid",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "filtros_territoriales": {
      ".read": true,
      ".write": "auth.token.email === 'carlos.admin@alcaldia.com'"
    },
    "historial_sesiones": {
      ".read": "auth.token.email === 'carlos.admin@alcaldia.com'",
      ".write": "auth != null"
    },
    "presencia": {
      ".read": "auth.token.email === 'carlos.admin@alcaldia.com'",
      "$uid": {
        ".write": "auth != null && $uid === auth.uid"
      }
    },
    "config": {
      ".read": "auth != null",
      ".write": "auth.token.email === 'carlos.admin@alcaldia.com'"
    },
    "equipos": {
      ".read": "auth != null && (auth.token.email === 'carlos.admin@alcaldia.com' || root.child('operadores').child(auth.uid).child('rol').val() === 'admin')",
      ".write": "auth.token.email === 'carlos.admin@alcaldia.com'"
    },
    "visitas": {
      ".read": "auth.token.email === 'carlos.admin@alcaldia.com' || root.child('operadores').child(auth.uid).exists()",
