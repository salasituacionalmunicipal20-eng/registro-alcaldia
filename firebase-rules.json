        ".write": "auth.token.email === 'carlos.admin@alcaldia.com' || (auth != null && root.child('operadores').child(auth.uid).exists())"
      }
    },
    "historial_cambios": {
      ".read": "auth.token.email === 'carlos.admin@alcaldia.com' || root.child('operadores').child(auth.uid).child('rol').val() === 'admin'",
      ".write": "auth.token.email === 'carlos.admin@alcaldia.com' || (auth != null && root.child('operadores').child(auth.uid).exists())"
    },
